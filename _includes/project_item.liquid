<div class="project-item">

	<div class="image-container">

		{%
			include protected_image.liquid
			src=include.item.poster
			alt=include.item.poster-alt
		%}

	</div>

	<div class="content">

		<p class="title">
			{{ include.item.title }}
		</p>

		<p class="subtitle">
			{{ include.item.subtitle  }}
		</p>

	</div>

	<div class="info-container">

		<button command="show-modal" commandfor="{{ include.item.id }}">
			<svg width="18" height="18">
				<use href="/assets/icons.svg#info-square-icon" xlink:href="/assets/icons.svg#info-square-icon"></use>
			</svg>
		</button>

	</div>

	{% 
		include project_modal.liquid 
		item=include.item
	%}

</div>