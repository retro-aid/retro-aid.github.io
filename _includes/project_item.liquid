<div class="project-item">

	<div class="image-container">

		<img src="{{ include.item.image }}" alt="{{ include.item.image-alt }}">

	</div>

	<div class="content">

		<p style="color: #111111; text-align: left; line-height: 1.5rem; font-weight: 400;">
			{{ include.item.title }}
		</p>

		<p style="text-align: left; line-height: 1.5rem;">
			{{ include.item.subtitle  }}
		</p>

	</div>

</div>